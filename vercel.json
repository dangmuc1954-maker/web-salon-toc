{
  "version": 2,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "web-salon-toc"
      }
    }
  ],
  "services": {
    "web-salon-toc": {
      "root": ".",
      "entrypoint": "server.js",
      "buildCommand": "npm install"
    }
  }
}
